LoginBtn.MouseButton1Click:Connect(function()
    if KeyBox.Text == KEY then
        LoginFrame.Visible = false
        ToggleBtn.Visible = true
        MainFrame.Visible = true
    else
        KeyBox.Text = ""
        KeyBox.PlaceholderText = "Wrong Key!"
    end
end)

ToggleBtn.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)

StartButton.MouseButton1Click:Connect(function()
    local target = nil
    for _, i in pairs(game:GetService("ReplicatedStorage"):WaitForChild("Items"):GetChildren()) do
        if string.find(string.lower(i.Name), string.lower(TextBox.Text)) then target = i break end
    end
    if target then
        local args = {target, {questName = "Dumplings Quest", questRequiredItems = {}, prizeItem = "Rainbow Dumpling"}}
        for t = 1, 4 do
            task.spawn(function()
                for i = 1, 500 do
                    game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("GetItem"):FireServer(unpack(args))
                end
            end)
        end
    end
end)

